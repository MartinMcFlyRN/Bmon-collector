# /etc/bmon-collector/env  (chmod 600, owner root)
BMON_LISTEN=127.0.0.1:8080
BMON_DSN=bmon_collector:CAMBIAMI@tcp(127.0.0.1:3306)/bmon_collector
# Le stesse credenziali che oggi usate in "set mmonit http://utente:password@...".
# Più coppie separate da virgola, utile per ruotarle senza fermare gli host.
BMON_AUTH=monit:CAMBIAMI
BMON_TRUSTED_PROXIES=127.0.0.1/32,::1/128
BMON_LOG_LEVEL=info
# Host offline: nessun report da più di max(BMON_OFFLINE_MIN, BMON_OFFLINE_CYCLES × poll)
BMON_OFFLINE_CYCLES=3
BMON_OFFLINE_MIN=3m
