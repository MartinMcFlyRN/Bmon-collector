# /etc/bmon-collector/env  (chmod 600, owner root)
BMON_LISTEN=127.0.0.1:8080
BMON_DSN=bmon_collector:CHANGEME@tcp(127.0.0.1:3306)/bmon_collector
# The same credentials your hosts use in "set mmonit http://user:password@...".
# Several pairs can be separated by commas, handy to rotate them without touching the hosts.
BMON_AUTH=monit:CHANGEME
BMON_TRUSTED_PROXIES=127.0.0.1/32,::1/128
BMON_LOG_LEVEL=info
# Host offline: no report for more than max(BMON_OFFLINE_MIN, BMON_OFFLINE_CYCLES × poll)
BMON_OFFLINE_CYCLES=3
BMON_OFFLINE_MIN=3m
# Monit httpd credentials found in the reports, used by Bmon-web to send
# start/stop/restart/monitor/unmonitor. Key: openssl rand -base64 32
# (same value in the Bmon-web config, monit.credentials_key).
BMON_STORE_CREDENTIALS=true
BMON_CREDENTIALS_KEY=
